def is_automorphic(number):
    temp = number
    square_of_num = number**2
    flag=True
    while number>0:
        num_d=number%10
        sq_d = square_of_num%10
        if num_d!=sq_d:
           flag = False
           break
        number//=10
        square_of_num//=10
    if flag:
        print(f"{temp} is an Automorphic Number")
    else:
        print(f"{temp} is not an Automorphic Number")
