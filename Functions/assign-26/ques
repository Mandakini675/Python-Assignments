def is_spy(number):
    temp = number
    sum_of_digits=0
    prod_of_digits = 1
    while temp>0:
        d = temp%10
        sum_of_digits+=d
        prod_of_digits*=d 
        temp//=10
    if sum_of_digits==prod_of_digits:
        print(f"{number} is a Spy Number")
    else:
        print(f"{number} is not a Spy Number")
    
